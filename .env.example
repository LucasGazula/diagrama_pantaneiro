# JWT signing secret — generate a long random value
JWT_SECRET=change-me-to-a-long-random-string
JWT_LIFETIME_SECONDS=900
REFRESH_LIFETIME_SECONDS=2592000
# Use true when serving through HTTPS.
REFRESH_COOKIE_SECURE=false

# Brapi.dev token (optional — leave blank for public tier rate limits)
BRAPI_TOKEN=
